# Copy to .env and edit — the proxy loads .env automatically at startup.
# Every variable is optional; the values below are the defaults.

LOG_LEVEL=info

# Where the proxy listens, and the model name it reports.
MUSE_PROXY_HOST=127.0.0.1
MUSE_PROXY_PORT=8787
MUSE_PROXY_MODEL=muse-spark

# If set, clients must send this key (Authorization: Bearer … or x-api-key).
# Leave unset for local-only use. An empty value counts as unset.
# MUSE_PROXY_KEY=

# Where `npm run login` writes, and the server reads, your Muse session.
MUSE_SESSION_PATH=./session.json
MUSE_STORAGE_STATE_PATH=./storage_state.json

# Where named sessions (X-Muse-Session / per-agent tokens) are persisted
# so a side chat can be RESUMED after the proxy restarts. To forget all
# session mappings: stop the proxy, delete this file, restart.
MUSE_SESSIONS_STORE_PATH=./sessions-store.json

# Timezone the agent sees for dates/feed. Default is the author's
# (Asia/Calcutta) — set this to your own, e.g. America/New_York.
MUSE_TZ=Asia/Calcutta

# Non-Windows users: match the fingerprint to the browser you logged in
# with, e.g. MUSE_PLATFORM='"macOS"' and a Mac Chrome MUSE_UA.
# MUSE_UA=
# MUSE_PLATFORM=

# Debug only — never share files these produce (they contain session data):
# PROXY_DEBUG=1        # append per-chunk diagnostics to ./proxy-debug.log
# DUMP_ATTESTATION=1   # write attestation-dump.json on the next handshake
